    memory-controller@e000e000 {
      #address-cells = 00000001
      #size-cells = 00000001
      status = 'okay'
      clock-names = 'memclk\x00apb_pclk'
      clocks = 00000001 0000000b 00000001 0000002c
      compatible = 'arm,pl353-smc-r2p1\x00arm,primecell'
      interrupt-parent = 00000004
      interrupts = 00000000 00000012 00000004
      ranges = 
      reg = e000e000 00001000
      flash@e1000000 {
        status = 'okay'
        compatible = 'arm,pl353-nand-r2p1'
        reg = e1000000 01000000
        #address-cells = 00000001
        #size-cells = 00000001
        arm,nand-cycle-t0 = 00000003
        arm,nand-cycle-t1 = 00000003
        arm,nand-cycle-t2 = ''
        arm,nand-cycle-t3 = 00000001
        arm,nand-cycle-t4 = 00000001
        arm,nand-cycle-t5 = 00000001
        arm,nand-cycle-t6 = 00000002
        nand-bus-width = 00000008
        partition@0x00000000 {
          label = 'boot'
          reg = '\x00\x00\x00\x00\x00@'
        }
        partition@0x00400000 {
          label = 'bootenv'
          reg = 00400000 00020000
        }
        partition@0x00420000 {
          label = 'kernel'
          reg = 00420000 00b00000
        }
        partition@0x00f20000 {
          label = 'jffs2'
          reg = 00f20000 06e00000
        }
      }
      flash@e2000000 {
        status = 'disabled'
        compatible = 'cfi-flash'
        reg = e2000000 02000000
        #address-cells = 00000001
        #size-cells = 00000001
      }
    }
