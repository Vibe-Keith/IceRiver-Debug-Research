      clkc@100 {
        u-boot,dm-pre-reloc = 
        #clock-cells = 00000001
        compatible = 'xlnx,ps7-clkc'
        fclk-enable = 00000001
        clock-output-names = 'armpll\x00ddrpll\x00iopll\x00cpu_6or4x\x00cpu_3or2x\x00cpu_2x\x00cpu_1x\x00ddr2x\x00ddr3x\x00dci\x00lqspi\x00smc\x00pcap\x00gem0\x00gem1\x00fclk0\x00fclk1\x00fclk2\x00fclk3\x00can0\x00can1\x00sdio0\x00sdio1\x00uart0\x00uart1\x00spi0\x00spi1\x00dma\x00usb0_aper\x00usb1_aper\x00gem0_aper\x00gem1_aper\x00sdio0_aper\x00sdio1_aper\x00spi0_aper\x00spi1_aper\x00can0_aper\x00can1_aper\x00i2c0_aper\x00i2c1_aper\x00uart0_aper\x00uart1_aper\x00gpio_aper\x00lqspi_aper\x00smc_aper\x00swdt\x00dbg_trc\x00dbg_apb'
        reg = 00000100 00000100
